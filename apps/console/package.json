{
  "name": "@bridgistic/console",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "seed:registry": "node scripts/seed-registry.mjs",
    "seed:db": "node scripts/seed-db.mjs",
    "deploy": "npm run build && wrangler pages deploy dist --project-name bridgistic-console",
    "deploy:functions": "wrangler pages deploy dist --project-name bridgistic-console",
    "test": "vitest run",
    "typecheck": "tsc -b && tsc -p tsconfig.functions.json",
    "typecheck:functions": "tsc -p tsconfig.functions.json"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "lucide-react": "^0.510.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261022.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "sql.js": "^1.15.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.107.1"
  }
}
