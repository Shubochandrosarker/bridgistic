# Public, non-secret values. Set in the Cloudflare Pages project, not in git.
# Paddle client-side token (starts with live_ or test_). Same token pay.wpistic.com uses.
VITE_PADDLE_CLIENT_TOKEN=
# production | sandbox
VITE_PADDLE_ENV=production
# Optional overrides. Defaults are the real Paddle prices on "Bridgistic Pro":
#   lifetime pri_01m6jjwzmy59ck0t0fgs87g37f ($69.00 one time)
#   monthly  pri_01m1ykar8aq033865h68a4b9hh ($12.00 per month, after the offer)
#   yearly   pri_01m1ykaqyaaeewsbah07akmpka ($99.00 per year, after the offer)
VITE_PADDLE_PRICE_LIFETIME=pri_01m6jjwzmy59ck0t0fgs87g37f
VITE_PADDLE_PRICE_MONTHLY=
VITE_PADDLE_PRICE_YEARLY=
# Stripe is offered through the same-origin Pages Function and api.wpistic.com.
# These switches are public/non-secret; Stripe secret and webhook keys stay on the API.
VITE_STRIPE_CHECKOUT=0
VITE_STRIPE_SESSION_URL=/api/stripe-checkout
# Offer status endpoint (Pages Function in functions/api/offer-status.js).
VITE_OFFER_STATUS_URL=/api/offer-status
# Server-side only (Pages secret, never VITE_): PADDLE_API_KEY with transaction.read only.
