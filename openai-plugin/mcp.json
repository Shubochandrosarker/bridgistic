{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "bridgistic": {
      "type": "streamable-http",
      "url": "https://mcp.bridgistic.app/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "authorizationUrl": "https://mcp.bridgistic.app/authorize",
            "tokenUrl": "https://mcp.bridgistic.app/token",
            "resource": "https://mcp.bridgistic.app/mcp",
            "authorizationServerBase": "https://mcp.bridgistic.app",
            "baseScopes": ["site:read", "posts:read"],
            "defaultScopes": ["site:read", "posts:read"],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
