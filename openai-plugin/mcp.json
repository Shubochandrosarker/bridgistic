{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "bridgistic": {
      "type": "streamable-http",
      "url": "https://mcp.bridgistic.app/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "resource": "https://mcp.bridgistic.app",
            "registrationUrl": "https://mcp.bridgistic.app/register",
            "baseScopes": ["site:read", "posts:read"],
            "defaultScopes": ["site:read", "posts:read"]
          }
        }
      }
    }
  }
}
